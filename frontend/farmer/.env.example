# ApnaDairy farmer mobile app — copy to `.env` (same folder) and fill in.
# NEVER commit `.env` to git, and never paste real secrets into chat or docs.

# FastAPI farmer backend base URL — use the URL the phone can reach.
# Physical phone testing: your laptop's LAN IP (e.g. 192.168.1.10),
# NOT localhost / 127.0.0.1 — the phone cannot reach your laptop's localhost.
# Find your IP: Windows -> ipconfig | look for "IPv4 Address".
EXPO_PUBLIC_API_URL=http://<your-laptop-lan-ip>:8000

# Supabase project for the mobile app (anon/publishable key ONLY — safe to
# ship in the app). NEVER put a service_role key here.
# Supabase dashboard -> Project Settings -> API -> Project URL + anon public key.
# Also add the OAuth redirect URL in the dashboard:
#   Authentication -> URL Configuration -> Redirect URLs -> apnadairy://auth/callback
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WEB Supabase project — farmer auth + Google OAuth (backend validates
# web-project JWTs). Dashboard: apnadairy-web project -> Settings -> API.
# Also required in dashboards (user-side):
#   Supabase web project: Authentication -> Providers -> Google ENABLED
#   Supabase web project: Authentication -> URL Configuration -> Redirect URLs
#     must contain  apnadairy://auth/callback
#   Google Cloud console: Authorized redirect URIs must contain
#     https://aquatwwnpvnmirkqnhlp.supabase.co/auth/v1/callback
EXPO_PUBLIC_WEB_SUPABASE_URL=https://aquatwwnpvnmirkqnhlp.supabase.co
EXPO_PUBLIC_WEB_SUPABASE_ANON_KEY=your-web-anon-key-here

# CUSTOMER (B2C) backend — FastAPI on Vercel. Required for the Customer
# role: login, signup, email OTP verification and the customer home.
# This is the production URL of the apna-dairy-customer-api deployment.
EXPO_PUBLIC_B2C_API_URL=https://apna-dairy-customer-api.vercel.app
